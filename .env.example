# ==============================================================================
# SŪTRA Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# --- Core Platform Settings ---
APP_ENV=development                       # Options: development, staging, production
LOG_LEVEL=INFO                            # Options: DEBUG, INFO, WARNING, ERROR
SUTRA_HOME=~/.agentbridge           # Storage root for state, databases, and logs

# --- Local Runtime & Control Plane ---
SUTRA_GATEWAY_URL=                   # wss://host:8766/v1/devices/connect
SUTRA_CONTROL_PLANE_URL=             # https://host:8766 (derived from gateway host when blank)
SUTRA_TLS_CA_FILE=                   # Optional PEM CA file; system trust is used when blank
SUTRA_RECONNECT_MAX_BACKOFF=30      # Max exponential backoff seconds for reconnects

# --- Control Plane Server ---
SUTRA_CONTROL_PLANE_TOKEN=           # Random operator API token; use at least 32 characters
SUTRA_CONTROL_PLANE_DB=              # Optional SQLite path (default: SUTRA_HOME/control-plane.sqlite3)
SUTRA_TLS_CERTFILE=                  # Required by `sutra control-plane`
SUTRA_TLS_KEYFILE=                   # Required by `sutra control-plane`; keep private

# --- Telegram Bot Interface (Optional if using Web/Discord) ---
TELEGRAM_BOT_TOKEN=                       # Bot token from @BotFather (e.g., 123456:ABC-DEF...)
TELEGRAM_ALLOWED_USER_IDS=                # Comma-separated list of authorized Telegram User IDs
TELEGRAM_POLLING_MODE=long_polling        # long_polling or webhook; webhook is enabled when URL and secret are set
TELEGRAM_WEBHOOK_URL=                     # Optional public HTTPS URL ending in /v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=                  # Random Telegram webhook secret token

# --- Connectivity & Control Request Policy ---
NETWORK_WARNING_RTT_MS=800
NETWORK_MAX_RTT_MS=1500
NETWORK_MAX_PACKET_LOSS_PERCENT=10
CONTROL_REQUEST_WARNING_SECONDS=3
CONTROL_REQUEST_TIMEOUT_SECONDS=7
NETWORK_PROBE_INTERVAL_SECONDS=5
NETWORK_RECOVERY_PROBE_COUNT=3
NETWORK_FAILURE_PROBE_COUNT=3

# --- Rate Limiting & Resilience ---
RATE_LIMIT=60                              # Per-identity requests per window
RATE_LIMIT_WINDOW=60                       # Rate limit sliding window in seconds
RATE_LIMIT_GLOBAL=600                      # Global rate limit cap across all identities (0 = disabled)
MAX_RETRIES=2                              # Max retry attempts for transient downstream failures
RETRY_BASE_DELAY=1.0                       # Base delay seconds for exponential backoff
RETRY_MAX_DELAY=30.0                       # Max delay seconds cap for backoff

# --- Circuit Breaker ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5        # Consecutive failures before opening circuit
CIRCUIT_BREAKER_OPEN_TIMEOUT=30.0          # Seconds to remain OPEN before probing (cooldown)
CIRCUIT_BREAKER_HALF_OPEN_PROBES=1         # Number of concurrent probes allowed in HALF_OPEN

# --- AI & Local LLM Engine (Zero-Paid-API Support) ---
LLM_PROVIDER=ollama                       # Options: ollama, vllm, openai, anthropic, gemini, none
OLLAMA_BASE_URL=http://localhost:11434    # Base endpoint for local Ollama daemon
OLLAMA_MODEL=qwen2.5-coder:7b             # Local model for summaries, risk checks, loop detector
# Optional Cloud LLM Fallbacks (Leave empty if using 100% local Ollama):
OPENAI_API_KEY=                           # Optional: sk-...
ANTHROPIC_API_KEY=                        # Optional: sk-ant-...
GEMINI_API_KEY=                           # Optional: AIzaSy...

# --- GitHub Integration (Optional) ---
GITHUB_TOKEN=                             # GitHub Personal Access Token (repo scope)
GITHUB_DEFAULT_OWNER=                     # Default GitHub user or organization

# --- Google Jules Integration (Optional) ---
JULES_CLI_ENABLED=false                   # Set to true if @google/jules is installed locally
JULES_AUTO_PULL_ON_MERGE=false            # Automatically pull remote PR branches on local completion
